---
layout: base.njk
lang: en
title: About
permalink: /about/
altEn: /about/
altEs: /es/
---
{%- set L = lang or "en" -%}{%- set u = ui[L] -%}{%- set tt = site.t[L] -%}{%- set c = site.cfg.candidate -%}{%- set mb = site.cfg.message_box -%}{%- set pre = "/es" if L == "es" else "" -%}
<section><div class="wrap split">
  <div>
    <h1>{{ u.meet }} {{ c.first_name }}</h1>
    <p class="core">{{ tt.bio_short }}</p>
    <ul>{% for b in tt.bio_points %}<li>{{ b }}</li>{% endfor %}</ul>
    <h2>Why {{ c.first_name }} is running</h2>
    <p>{{ tt.core }}</p>
    <p><a class="btn" href="/issues/">{{ u.read_plan }}</a></p>
  </div>
  <div class="photo" role="img" aria-label="Photo of {{ c.full_name }}">Candidate photo</div>
</div></section>
